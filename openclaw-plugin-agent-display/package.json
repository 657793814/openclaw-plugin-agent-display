{
  "name": "openclaw-plugin-agent-display",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run embed && tsc -p tsconfig.json && openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "embed": "node scripts/embed-dashboard.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "docs"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.7"
  },
  "dependencies": {
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "openclaw": "latest",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.10.7"
    },
    "build": {
      "openclawVersion": "2026.10.7"
    }
  }
}
