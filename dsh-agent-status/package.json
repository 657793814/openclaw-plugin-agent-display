{
  "name": "dsh-agent-status",
  "version": "1.3.0",
  "description": "Read-only work-state HUD and standalone agent operations screen for DeepSeek Harness — idle / thinking / tool / awaiting / done, token-protected and injected into the existing shell.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "runtime",
    "scripts",
    "cordis.patch.yml",
    "dev",
    "tests",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-status",
    "observability",
    "hud"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node dev/mock-host.mjs",
    "install:desktop": "node scripts/install.mjs",
    "uninstall:desktop": "node scripts/uninstall.mjs"
  }
}
